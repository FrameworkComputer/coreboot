# Layout taken from the vendor descriptor (adl 3.20):
#   fd       0x000000 - 0x000fff
#   ec       0x001000 - 0x080fff
#   me       0x081000 - 0x841fff
#   devexp2  0x842000 - 0xffffff
#   bios     0x1000000 - 0x1ffffff
FLASH 32M {
	SI_DESC 4K
	SI_EC 512K
	SI_ME 7940K
	SI_DEVICEEXP2 7928K
	SI_BIOS@16M 16M {
		RW_MRC_CACHE 64K
		SMMSTORE(PRESERVE) 512K
		FMAP 4K
		COREBOOT(CBFS)
	}
}
