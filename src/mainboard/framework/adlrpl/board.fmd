# Layout taken from the vendor descriptor (adl 3.20):
#   fd       0x000000 - 0x000fff
#   ec       0x001000 - 0x080fff
#   me       0x081000 - 0x841fff
#   devexp2  0x842000 - 0xffffff
#   bios     0x1000000 - 0x1ffffff
FLASH 32M {
	SI_DESC 4K
	SI_EC 512K
	SI_ME 7940K
	SI_DEVICEEXP2 7928K
	SI_BIOS@16M 16M {
		RW_SPD_CACHE(PRESERVE) 20K
		# Pad so that RW_MRC_CACHE and SMMSTORE start 64K-aligned
		RW_UNUSED 44K
		RW_MRC_CACHE 64K
		SMMSTORE(PRESERVE) 512K
		RW_ELOG(PRESERVE) 4K
		RW_NVRAM(PRESERVE) 8K
		RW_SHARED 16K {
			SHARED_DATA 8K
			VBLOCK_DEV 8K
		}
		RW_SECTION_A 5M {
			VBLOCK_A 8K
			FW_MAIN_A(CBFS)
			RW_FWID_A 128
		}
		RW_SECTION_B 5M {
			VBLOCK_B 8K
			FW_MAIN_B(CBFS)
			RW_FWID_B 128
		}
		WP_RO {
			RO_SECTION {
				FMAP 4K
				RO_FRID 128
				GBB 16K
				COREBOOT(CBFS)
			}
		}
	}
}
