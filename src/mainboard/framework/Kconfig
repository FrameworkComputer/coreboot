if VENDOR_FRAMEWORK

choice
	prompt "Mainboard model"

source "src/mainboard/framework/*/Kconfig.name"

endchoice

source "src/mainboard/framework/*/Kconfig"

config MAINBOARD_VENDOR
	default "Framework"

config EC_GOOGLE_CHROMEEC_ACPI_HID
	default "FRMWC004"

config FRAMEWORK_COMMON_CFR
	def_bool y
	select DRIVERS_OPTION_CFR_ENABLED if PAYLOAD_EDK2 && SMMSTORE

config FRAMEWORK_TOUCHSCREEN_STYLUS
	bool
	help
	  Selected by boards that have a touchscreen stylus protocol switch GPIO
	  (stylus_sw_r), i.e. the Framework Laptop 12. Exposes a CFR option to
	  choose between the MPP and USI stylus protocols.

config FRAMEWORK_INPUT_DECK
	bool
	default n
	help
	  Selected by boards that have detectable input deck, to enable the Input
	  Deck Mode CFR option.

config FRAMEWORK_EC_PD_CHIP_COUNT
	int
	depends on EC_GOOGLE_CHROMEEC
	help
	  Number of USB-C Power Delivery controllers on the board. Used to size
	  the per-controller PD firmware version readouts in the CFR setup menu.
	  Each board sets its own value.

# Keyboard matrix positions (row/col) of the keys remapped by the key remap CFR
# options (swap Ctrl/Fn, Copilot key). The defaults match the Framework Laptop
# 13 keyboard; boards with a different matrix override these.
if EC_GOOGLE_CHROMEEC

config FRAMEWORK_KBD_FN_ROW
	int
	default 2

config FRAMEWORK_KBD_FN_COL
	int
	default 2

config FRAMEWORK_KBD_LEFT_CTRL_ROW
	int
	default 1

config FRAMEWORK_KBD_LEFT_CTRL_COL
	int
	default 12

config FRAMEWORK_KBD_RIGHT_CTRL_ROW
	int
	default 0

config FRAMEWORK_KBD_RIGHT_CTRL_COL
	int
	default 12

endif # EC_GOOGLE_CHROMEEC

endif # VENDOR_FRAMEWORK
