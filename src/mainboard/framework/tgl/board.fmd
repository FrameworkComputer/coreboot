FLASH 32M {
	SI_DESC 4K
	SI_ME 16384K
	SI_DEVICEEXT2 4092K
	SI_BIOS@20M 12M {
		# EC firmware update
		EC_FW(PRESERVE) 512K
		# PD firmware update
		PD1(PRESERVE) 256K
		PD2(PRESERVE) 256K
		RW_MRC_CACHE 64K
		SMMSTORE(PRESERVE) 256K
		RW_SPD_CACHE(PRESERVE) 4K
		RW_ELOG(PRESERVE) 4K
		RW_NVRAM(PRESERVE) 8K
		RW_SHARED 16K {
			SHARED_DATA 8K
			VBLOCK_DEV 8K
		}
		RW_SECTION_A 3584K {
			VBLOCK_A 8K
			FW_MAIN_A(CBFS)
			RW_FWID_A 128
		}
		RW_SECTION_B 3584K {
			VBLOCK_B 8K
			FW_MAIN_B(CBFS)
			RW_FWID_B 128
		}
		WP_RO {
			RO_SECTION {
				FMAP 4K
				RO_FRID 128
				GBB 16K
				COREBOOT(CBFS)
			}
		}
	}
}
