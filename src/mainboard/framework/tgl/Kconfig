config BOARD_FRAMEWORK_TGL_COMMON
	def_bool n
	select BOARD_ROMSIZE_KB_32768
	select DRIVERS_I2C_HID
	select DRIVERS_INTEL_USB4_RETIMER
	select DRIVERS_GFX_GENERIC
	select EC_GOOGLE_CHROMEEC
	select EC_GOOGLE_CHROMEEC_ESPI
	select EC_GOOGLE_CHROMEEC_MEC
	select EC_GOOGLE_CHROMEEC_ACPI_MEMMAP
	select HAVE_ACPI_RESUME
	select HAVE_ACPI_TABLES
	select INTEL_GMA_HAVE_VBT
	select INTEL_LPSS_UART_FOR_CONSOLE
	select MAINBOARD_HAS_TPM2
	select MEMORY_MAPPED_TPM
	select NO_UART_ON_SUPERIO
	select SOC_INTEL_COMMON_BLOCK_HDA_VERB
	select SOC_INTEL_ENABLE_USB4_PCIE_RESOURCES
	select SPD_CACHE_ENABLE
	select SPD_CACHE_IN_FMAP
	select SPD_READ_BY_WORD
	select SYSTEM_TYPE_LAPTOP
	select TPM_MEASURED_BOOT

config BOARD_FRAMEWORK_TGL
	select BOARD_FRAMEWORK_TGL_COMMON
	select SOC_INTEL_TIGERLAKE

if BOARD_FRAMEWORK_TGL_COMMON

config FMDFILE
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/board.fmd"

config MAINBOARD_DIR
	default "framework/tgl"

config MAINBOARD_PART_NUMBER
	default "TGL"

config MAINBOARD_SMBIOS_PRODUCT_NAME
	default "Laptop 13 (11th Gen Intel Core)"

config MAINBOARD_FAMILY
	default "Laptop"

config CONSOLE_POST
	default y

config D3COLD_SUPPORT
	default y

# DDR4 SO-DIMMs carry a 512 byte SPD EEPROM
config DIMM_SPD_SIZE
	default 512

config ONBOARD_VGA_IS_PRIMARY
	default y

config POST_DEVICE
	default n

# LPSS UART2 (GPP_C20/GPP_C21) is routed to the debug header
config UART_FOR_CONSOLE
	default 2

config TPM_PIRQ
	hex
	default 0x2c	# GPP_B20 TPM_PIRQ#

# PM Timer Disabled, saves power
config USE_PM_ACPI_TIMER
	default n

config VBOOT
	default y
	select VBOOT_ALWAYS_ENABLE_DISPLAY
	select VBOOT_CLEAR_RECOVERY_IN_RAMSTAGE
	select VBOOT_NO_BOARD_SUPPORT
	select VBOOT_SLOTS_RW_AB

endif
