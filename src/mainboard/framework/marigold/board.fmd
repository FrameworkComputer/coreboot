FLASH 32M {
	SI_DESC 16K
	# Embedded Controller firmware: Intel flash descriptor region 8 ("EC"),
	# at 0x4000, 512K (ec.bin is exactly 512K). This lives *outside* the BIOS
	# region. coreboot does not currently build or flash it (would require a
	# full descriptor-mode build); the vendor flashes the EC separately
	# (DISCRETE_EC_FLASH). Reserved here so the layout is complete.
	SI_EC(PRESERVE) 512K
	SI_ME 9616K
	SI_DEVICEEXP2 6240K
	SI_BIOS@16M 16M {
		# PD Firmware for use in updates
		PD1(PRESERVE) 256K
		PD2(PRESERVE) 256K
		# Factory-programmed serial numbers
		RW_FACTORY(PRESERVE) 16K
		# Pad so that RW_MRC_CACHE and SMMSTORE start 64K-aligned
		RW_UNUSED 28K
		RW_SPD_CACHE(PRESERVE) 20K
		RW_MRC_CACHE 64K
		SMMSTORE(PRESERVE) 256K
		RW_ELOG(PRESERVE) 4K
		RW_NVRAM(PRESERVE) 8K
		RW_SHARED 16K {
			SHARED_DATA 8K
			VBLOCK_DEV 8K
		}
		RW_SECTION_A 5M {
			VBLOCK_A 8K
			FW_MAIN_A(CBFS)
			RW_FWID_A 128
		}
		RW_SECTION_B 5M {
			VBLOCK_B 8K
			FW_MAIN_B(CBFS)
			RW_FWID_B 128
		}
		WP_RO {
			RO_SECTION {
				FMAP 4K
				RO_FRID 128
				GBB 16K
				COREBOOT(CBFS)
			}
		}
	}
}
