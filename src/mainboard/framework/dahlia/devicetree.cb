# SPDX-License-Identifier: GPL-2.0-or-later
#
# Dahlia (Intel Wildcat Lake) devicetree.

chip soc/intel/pantherlake

	# Enable Enhanced Intel SpeedStep
	register "eist_enable" = "true"

	# Sustained power. The chipset default for WCL_CORE is PL1 = base power =
	# 15 W, which throttles noticeably harder than the vendor firmware: an
	# all-core stress test settles at 15.3 W / 2860 MHz on coreboot versus
	# 20.4 W / 3160 MHz on a vendor unit (measured with PL1 as the live limit
	# reason in MSR 0x64F for both).
	#
	# 20 W matches what the vendor programs (MSR 0x610 = 0x0000811800dd80a0)
	# and pcode sustains it even though MSR_PKG_POWER_INFO reports a 15 W base
	# power, so PL1 above base power is fine on this SKU. PL2 and PL4 are the
	# chipset defaults, repeated because a devicetree array element replaces
	# the whole struct.
	register "power_limits_config[WCL_CORE]" = "{
		.tdp_pl1_override = 20,
		.tdp_pl2_override = 35,
		.tdp_pl4 = 93,
	}"

	# TCC activation offset = Tjmax. Match vendor BIOS
	register "tcc_offset" = "0"

	# GPE0 DW routing: which GPIO communities can generate GPE/wake events.
	# GPP_A covers the EC HID mediakeys interrupt (A09)
	# GPP_E covers the touchscreen interrupt (E18)
	# GPP_F covers the touchpad (F18) and EC_PAD_MODE tablet-mode (F11) interrupts
	register "pmc_gpe0_dw0" = "GPP_A"
	register "pmc_gpe0_dw1" = "GPP_E"
	register "pmc_gpe0_dw2" = "GPP_F"

	# S0ix enable for modern standby
	register "s0ix_enable" = "true"

	# DPTF policies under the dtt device below (drivers/intel/dptf).
	register "dptf_enable" = "true"

	# Maximum total system power consumption - roughly 100W TypeC + 50W battery
	register "psys_pmax_watts" = "149"

	# SAGV + power management
	register "sagv" = "SAGV_ENABLED"
	register "pch_pm_energy_report_enable" = "1"
	register "pch_slp_s3_min_assertion_width" = "SLP_S3_ASSERTION_1_MS"
	register "pch_slp_s4_min_assertion_width" = "SLP_S4_ASSERTION_3S"
	register "pch_slp_sus_min_assertion_width" = "SLP_SUS_ASSERTION_1_S"
	register "pch_slp_a_min_assertion_width" = "SLP_A_ASSERTION_98_MS"

	# Shut down the VCCSA rail down in low-power states
	register "vccsa_shutdown" = "1"

	# Full-function (Thunderbolt/USB4 + DP-alt) on JUSB1 and JUSB4
	register "tcss_cap_policy[0]" = "TCSS_TYPE_C_PORT_FULL_FUN"
	register "tcss_cap_policy[1]" = "TCSS_TYPE_C_PORT_FULL_FUN"

	device domain 0 on
		subsystemid 0xf111 0x0010 inherit

		device ref igpu on
			# DDIA is eDP
			register "ddi_port_A_config" = "1"
			register "ddi_ports_config" = "{
				[DDI_PORT_A] = DDI_ENABLE_HPD,
			}"
			chip drivers/gfx/generic
				# eDP panel + two DP-altmode Type-C ports
				register "device_count" = "3"
				# [DDIA] eDP
				register "device[0].name" = ""LCD0""
				register "device[0].type" = "panel"
				# [TCP0] JUSB1 DP-alt
				register "device[1].name" = ""DD01""
				register "device[1].use_pld" = "true"
				register "device[1].pld" = "ACPI_PLD_TYPE_C(LEFT, RIGHT, ACPI_PLD_GROUP(1, 0))"
				# [TCP1] JUSB4 DP-alt
				register "device[2].name" = ""DD02""
				register "device[2].use_pld" = "true"
				register "device[2].pld" = "ACPI_PLD_TYPE_C(RIGHT, RIGHT, ACPI_PLD_GROUP(2, 0))"
				device generic 0 on end
			end
		end

		device ref npu on end
		device ref iaa off end
		device ref dtt on
			chip drivers/intel/dptf
				# DPTF is modelled after the vendor firmware's 2.01 DPTF/IETM
				# implementation (ssdt18 "DptfTabl"), which coreboot's PTL SoC
				# HIDs already match. The Framework EC is a cros-ec derivative:
				# temperatures are read from the EC memory map (TSRx._TMP ->
				# EC0.TSRD()) and the EC owns fan control autonomously, so no
				# Active/fan policy is defined even though the vendor declares
				# a TFN1 _ART (its fan participant just mirrors what the EC
				# does on its own).
				#
				# Sensor index maps to the EC's memory-mapped sensor order
				# (zephyr/program/framework/laptop12/overlay.dtsi; same order
				# as the thermal zones at the bottom of this file). The vendor
				# EC orders battery before U31, otherwise the sets match:
				#   TSR0 = f75303 remote1, Q56 near CPU (vendor SEN2 "VCCGT")
				#   TSR1 = f75303 remote2, Q57 top skin (vendor SEN3)
				#   TSR2 = f75303 local, U31           (vendor SEN5 "bottom skin/DDR")
				#   TSR3 = battery                     (vendor SEN4)
				register "options.tsr[0].desc" = ""CPU""
				register "options.tsr[1].desc" = ""TopSkin""
				register "options.tsr[2].desc" = ""Local""
				register "options.tsr[3].desc" = ""Battery""

				# Passive policy: throttle the CPU (TCPU) to hold the sensors
				# below _PSV. The vendor declares _PSV = 65C on every sensor
				# and relates TCPU to the CPU-adjacent (TRT) and top-skin
				# (PSVT) sensors. The battery sensor is left to the critical
				# policy only (its vendor relationship is charger-sourced,
				# which coreboot's DPTF driver has no equivalent for).
				register "policies.passive" = "{
					[0] = DPTF_PASSIVE(CPU, TEMP_SENSOR_0, 65, 5000),
					[1] = DPTF_PASSIVE(CPU, TEMP_SENSOR_1, 65, 5000),
					[2] = DPTF_PASSIVE(CPU, TEMP_SENSOR_2, 65, 5000),
				}"

				# Critical policy: hibernate (S4) at 75C and shut down at
				# 80C, matching the vendor's _HOT = 75C and _CRT = 80C
				# declared on all four sensors.
				register "policies.critical" = "{
					[0] = DPTF_CRITICAL(TEMP_SENSOR_0, 80, SHUTDOWN),
					[1] = DPTF_CRITICAL(TEMP_SENSOR_1, 80, SHUTDOWN),
					[2] = DPTF_CRITICAL(TEMP_SENSOR_2, 80, SHUTDOWN),
					[3] = DPTF_CRITICAL(TEMP_SENSOR_3, 80, SHUTDOWN),
					[4] = DPTF_CRITICAL(TEMP_SENSOR_0, 75, S4),
					[5] = DPTF_CRITICAL(TEMP_SENSOR_1, 75, S4),
					[6] = DPTF_CRITICAL(TEMP_SENSOR_2, 75, S4),
					[7] = DPTF_CRITICAL(TEMP_SENSOR_3, 75, S4),
				}"

				# Power limits (PPCC) published to the CPU (TCPU) participant,
				# following the vendor's runtime-resolved shape (ssdt18 CPLX():
				# PL1 min hardcoded 0.125W, PL1 max = programmed PL1, window
				# PLW..PLW+4s; PL2 min = max = programmed PL2, no window; step
				# size 500mW from the DptfConfig efivar). The vendor programs
				# PL1 20W / PL2 35W (MSR 0x610), the same envelope coreboot
				# sets in power_limits_config above:
				#   PL1 0.125W..20W, 28-32s window, 0.5W step
				#   PL2 35W fixed (min=max), no window, 0.5W step
				# This is the range advertised to the OS DPTF driver; the EC
				# remains the final arbiter of the applied limits.
				register "controls.power_limits" = "{
					.pl1 = {
							.min_power = 125,
							.max_power = 20000,
							.time_window_min = 28 * MSECS_PER_SEC,
							.time_window_max = 32 * MSECS_PER_SEC,
							.granularity = 500,
						},
					.pl2 = {
							.min_power = 35000,
							.max_power = 35000,
							.time_window_min = 0,
							.time_window_max = 0,
							.granularity = 500,
						}
				}"

				device generic 0 alias dptf_policy on end
			end
		end

		device ref tbt_pcie_rp0 on end
		device ref tbt_pcie_rp1 on end

		device ref tcss_xhci on
			register "tcss_ports[0]" = "TCSS_PORT_DEFAULT(OC_SKIP)"
			register "tcss_ports[1]" = "TCSS_PORT_DEFAULT(OC_SKIP)"
			chip drivers/usb/acpi
				device ref tcss_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C (JUSB1)""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(LEFT, RIGHT, ACPI_PLD_GROUP(1, 0))"
						device ref tcss_usb3_port0 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C (JUSB4)""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_C(RIGHT, RIGHT, ACPI_PLD_GROUP(2, 0))"
						device ref tcss_usb3_port1 on end
					end
				end
			end
		end

		device ref tcss_dma0 on
			chip drivers/intel/usb4/retimer
				register "dfp[0].power_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_B21)"
				use tcss_usb3_port0 as dfp[0].typec_port
				device generic 0 on end
			end
			chip drivers/intel/usb4/retimer
				register "dfp[1].power_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_HIGH(GPP_B21)"
				use tcss_usb3_port1 as dfp[1].typec_port
				device generic 0 on end
			end
		end

		device ref xhci on
			register "usb2_ports" = "{
				[0] = USB2_PORT_TYPE_C(OC_SKIP),	/* JUSB1 */
				[1] = USB2_PORT_TYPE_C(OC_SKIP),	/* JUSB4 */
				[2] = USB2_PORT_TYPE_C(OC_SKIP),	/* JUSB3 */
				[3] = USB2_PORT_TYPE_C(OC_SKIP),	/* JUSB2 */
				[4] = USB2_PORT_MID(OC_SKIP),		/* Camera */
				/* [5] unused */
				[6] = USB2_PORT_MID(OC_SKIP),		/* Fingerprint */
				/* [7] WLAN/BT combo: BT is on CNVi (cnvi_bluetooth);
				   the discrete module's USB BT is left off. */
			}"
			# The two USB3-only Type-C ports
			register "usb3_ports[0]" = "USB3_PORT_DEFAULT(OC_SKIP)"
			register "usb3_ports[1]" = "USB3_PORT_DEFAULT(OC_SKIP)"
			chip drivers/usb/acpi
				device ref xhci_root_hub on
					# USB2 lines of the Type-C connectors
					# TODO: Add _PLD to match TCSS/USB3 SS descriptors
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C (JUSB1)""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C (JUSB4)""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port2 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C (JUSB3)""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port3 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB Type-C (JUSB2)""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port4 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Camera""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port5 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Fingerprint""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port7 on end
					end
				end
			end
		end

		device ref cnvi_wifi on
			register "cnvi_wifi_core" = "true"
			chip drivers/wifi/generic
				register "wake" = "GPE0_PME_B0"
				register "enable_cnvi_ddr_rfim" = "true"
				use cnvi_bluetooth as bluetooth_companion
				device generic 0 on end
			end
		end
		device ref cnvi_bluetooth on
			register "cnvi_bt_core" = "true"
			register "cnvi_bt_audio_offload" = "true"
		end

		device ref pmc_shared_sram on end

		# Configuring Touchpad, Touchscreen as I2C instead of THC
		device ref thc0 off end
		device ref thc1 off end

		device ref i2c1 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C1]" = "PchSerialIoPci"
			chip drivers/i2c/hid
				register "generic.hid" = ""FRMW0004""
				register "generic.desc" = ""EC Mediakeys""
				register "generic.irq_gpio" = "ACPI_GPIO_IRQ_LEVEL_LOW(GPP_A09)"
				register "hid_desc_reg_offset" = "0x55"
				device i2c 50 on end
			end
		end

		# Power monitor (PAC1954T) - not populated on mass production
		device ref i2c3 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C3]" = "PchSerialIoPci"
		end


		# Touchscreen (same part as sunflower)
		device ref i2c4 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C4]" = "PchSerialIoPci"
			chip drivers/i2c/hid
				register "generic.hid" = ""ILIT2901""
				register "generic.desc" = ""Touchscreen""
				register "generic.irq_gpio" = "ACPI_GPIO_IRQ_LEVEL_LOW_WAKE(GPP_E18)"
				register "hid_desc_reg_offset" = "0x01"
				device i2c 41 on end
			end
		end

		# Touchpad (same part as sunflower)
		device ref i2c5 on
			register "serial_io_i2c_mode[PchSerialIoIndexI2C5]" = "PchSerialIoPci"
			chip drivers/i2c/hid
				register "generic.hid" = ""PIXA3854""
				register "generic.desc" = ""Touchpad""
				register "generic.irq_gpio" = "ACPI_GPIO_IRQ_LEVEL_LOW_WAKE(GPP_F18)"
				register "hid_desc_reg_offset" = "0x20"
				device i2c 2c on end
			end
		end

		device ref pcie_rp1 on
			# SSD M.2 NVMe: PCIe x4, Gen4
			register "pcie_rp[PCIE_RP(1)]" = "{
				.clk_src = 3,
				.clk_req = 3,
				.flags = PCIE_RP_LTR | PCIE_RP_AER,
				.pcie_rp_aspm = ASPM_L0S_L1,
				.PcieRpL1Substates = L1_SS_L1_2,
			}"
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther"
				"M.2/M 2280 (J_SSD1)" "SlotDataBusWidth4X"
			chip soc/intel/common/block/pcie/rtd3
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_A08)"
				register "srcclk_pin" = "3"
				register "is_storage" = "true"
				register "add_acpi_dma_property" = "true"
				register "skip_on_off_support" = "true"
				register "ext_pm_support" = "ACPI_PCIE_RP_EMIT_ALL"
				register "use_rp_mutex" = "true"
				device generic 0 on end
			end
		end

		# BIOS/OS console
		device ref uart0 on
			register "serial_io_uart_mode[PchSerialIoIndexUART0]" = "PchSerialIoSkipInit"
		end

		device ref soc_espi on
			register "gen1_dec" = "LPC_IO(0x200, 0x10)"   # EC host cmd 0x200-0x20f
			register "gen2_dec" = "LPC_IO(0xe00, 0x100)"  # EC memmap   0xE00-0xEFF
			register "gen3_dec" = "LPC_IO(0xf00, 0x100)"  # EC extended 0xF00-0xFFF
			register "gen4_dec" = "LPC_IO(0x800, 0x100)"  # EC shared   0x800-0x8FF
			chip ec/google/chromeec
				device pnp 0c09.0 alias chrome_ec on end
			end
		end

		# Firmware TPM (Intel PTT)
		chip drivers/crb
			device mmio 0xfed40000 on end
		end

		device ref hda on
			register "pch_hda_dsp_enable" = "1"
			register "pch_hda_audio_link_hda_enable" = "1"
			register "pch_hda_sdi_enable[0]" = "true"
			register "pch_hda_idisp_link_tmode" = "HDA_TMODE_8T"
			register "pch_hda_idisp_link_frequency" = "HDA_LINKFREQ_96MHZ"
			register "pch_hda_idisp_codec_enable" = "1"
		end

		device ref smbus on end
	end

	# Q56 (F75303 remote1), close to the CPU. EC halt: 85C
	chip drivers/acpi/thermal_zone
		register "description" = ""CPU""
		use chrome_ec as temperature_controller
		register "sensor_id" = "0"
		register "hibernate_temperature" = "160"
		register "critical_temperature" = "170"
		register "use_acpi1_thermal_zone_scope" = "true"
		device generic 0 on end
	end
	# Q57 (F75303 remote2), top skin near H16. EC halt: 90C
	chip drivers/acpi/thermal_zone
		register "description" = ""TopSkin""
		use chrome_ec as temperature_controller
		register "sensor_id" = "1"
		register "hibernate_temperature" = "160"
		register "critical_temperature" = "170"
		register "use_acpi1_thermal_zone_scope" = "true"
		device generic 1 on end
	end
	# U31 (F75303 local). EC halt: 94C
	chip drivers/acpi/thermal_zone
		register "description" = ""Local""
		use chrome_ec as temperature_controller
		register "sensor_id" = "2"
		register "hibernate_temperature" = "160"
		register "critical_temperature" = "170"
		register "use_acpi1_thermal_zone_scope" = "true"
		device generic 2 on end
	end
	# Battery pack temperature over SMBus. EC halt: 66C
	chip drivers/acpi/thermal_zone
		register "description" = ""Battery""
		use chrome_ec as temperature_controller
		register "sensor_id" = "3"
		register "hibernate_temperature" = "160"
		register "critical_temperature" = "170"
		register "use_acpi1_thermal_zone_scope" = "true"
		device generic 3 on end
	end
end
